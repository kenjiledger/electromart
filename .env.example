# Copy to .env and edit. Never commit .env.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-change-me-dev-only-secret

# Owner account. Only this one owner account can ever exist.
OWNER_USERNAME=Anup
# DEVELOPMENT ONLY. The server REFUSES to start in production with this value.
# Used once, on first start, to create the owner; owner is forced to change it at first login.
OWNER_INITIAL_PASSWORD=9999

# Sample catalog (clearly labelled "sample"); set false in production
SEED_SAMPLE_DATA=true

# Optional paths
# DB_PATH=./data/electromart.db
# UPLOAD_DIR=./data/uploads

# Razorpay (optional - leave empty to use COD + owner-uploaded UPI QR only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
